{
  "extends": [
    "next/core-web-vitals",
    "plugin:jsx-a11y/recommended"
  ],
  "plugins": ["jsx-a11y"],
  "rules": {
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-debugger": "error",
    "react/self-closing-comp": "warn",
    "react/no-array-index-key": "warn",
    "import/no-duplicates": "warn"
  }
}
