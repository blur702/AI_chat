# =============================================================================
# AI Workstation Environment Configuration
# =============================================================================
# This is a template file. Copy to .env and update values for your environment.
#
# SECURITY WARNING: Never commit your .env file to version control!
# The .env file contains sensitive credentials and should remain local only.
# =============================================================================

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL with pgvector)
# -----------------------------------------------------------------------------
POSTGRES_DB=workstation
POSTGRES_USER=workstation_user
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=change_me_in_production
# Full connection string (used by backend services)
# Note: Uses internal Docker hostname 'postgres' for container-to-container communication
# IMPORTANT: Update this if you change POSTGRES_USER, POSTGRES_PASSWORD, or POSTGRES_DB above
DATABASE_URL=postgresql://workstation_user:change_me_in_production@postgres:5432/workstation

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Connection string for Redis (used for caching and task queue)
# Note: Password is included in URL for authenticated access
# IMPORTANT: Update this URL if you change REDIS_PASSWORD below
REDIS_URL=redis://:changeme_strong_redis_password@redis:6379/0
# IMPORTANT: Change this password in production!
REDIS_PASSWORD=changeme_strong_redis_password

# -----------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a secure random key for production!
# You can generate one with: openssl rand -hex 32
SECRET_KEY=generate_random_secret_key_here
# SearXNG secret key (required when limiter is enabled)
SEARX_SECRET_KEY=change_me_searxng_secret
# Environment mode: development, staging, production
ENVIRONMENT=development
# Enable debug mode (disable in production)
DEBUG=true
# Comma-separated list of allowed CORS origins
# Update these if you change CHAT_PORT, SANDBOX_PORT, or NGINX ports
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:3001,http://localhost:3002

# -----------------------------------------------------------------------------
# Admin User Configuration
# -----------------------------------------------------------------------------
# Default admin account (seeded on first startup if no admin exists)
ADMIN_USERNAME=admin
# IMPORTANT: Must be at least 8 characters and meet strength requirements
ADMIN_PASSWORD=change_me_admin_password

# Master admin users (protected, cannot be deactivated/deleted by other admins)
# Comma-separated list of usernames
MASTER_USERNAMES=master
# IMPORTANT: Must meet password strength requirements
MASTER_PASSWORD=change_me_master_password
# Optional display names for master users
# MASTER_FIRST_NAME=Master
# MASTER_SCREEN_NAME=Master

# -----------------------------------------------------------------------------
# GPU Services (Docker Compose)
# -----------------------------------------------------------------------------
# Ollama LLM service URL (Docker Compose service name)
OLLAMA_BASE_URL=http://ollama:11434
# ComfyUI image generation service URL (Docker Compose service name)
COMFYUI_BASE_URL=http://comfyui:8188
# Host port mappings for GPU services
OLLAMA_PORT=11434
COMFYUI_PORT=8188
# GPU device IDs (nvidia-smi index values)
OLLAMA_GPU_DEVICE_ID=1
COMFYUI_GPU_DEVICE_ID=0
# Number of utility GPUs exposed to backend container
BACKEND_GPU_UTILITY_COUNT=1
# Ollama models directory (bind-mounted into container to reuse existing models)
# On Windows: set to C:/Users/<you>/.ollama
# Relative paths are relative to the docker-compose.yml location
OLLAMA_MODELS_DIR=./.ollama

# -----------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# -----------------------------------------------------------------------------
# Backend API URL (as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8001
# WebSocket URL for real-time updates
NEXT_PUBLIC_WS_URL=ws://localhost:8001

# -----------------------------------------------------------------------------
# Port Configuration
# -----------------------------------------------------------------------------
# Host port mappings (internal container ports remain standard)
# Nginx uses standard ports 80/443; other services are offset to avoid conflicts

# PostgreSQL host port (internal: 5432)
POSTGRES_PORT=5433
# Redis host port (internal: 6379)
REDIS_PORT=6380
# Backend API host port (internal: 8000)
BACKEND_PORT=8001
# Chat app host port (internal: 3001)
CHAT_PORT=3001
# Nginx HTTP host port (internal: 80)
NGINX_HTTP_PORT=80
# Nginx HTTPS host port (internal: 443)
NGINX_HTTPS_PORT=443

# -----------------------------------------------------------------------------
# Sandbox / Container Configuration
# -----------------------------------------------------------------------------
# Default Docker image for project sandboxes
# SANDBOX_IMAGE=python:3.12-slim
# Idle timeout before sandbox container is stopped (seconds)
# SANDBOX_IDLE_TIMEOUT=3600
# Container memory limit
# SANDBOX_MEMORY_LIMIT=512m
# Container CPU quota (microseconds per 100ms period; 50000 = 50%)
# SANDBOX_CPU_QUOTA=50000
# Max command execution timeout (seconds)
# SANDBOX_COMMAND_TIMEOUT=300
# Cooldown after container creation failure (seconds)
# SANDBOX_CREATION_FAILURE_COOLDOWN=30
# Root directory for project files inside containers
# PROJECTS_ROOT=/workspace/projects

# -----------------------------------------------------------------------------
# Knowledge Base
# -----------------------------------------------------------------------------
# Upload directory for KB documents
# KB_UPLOAD_DIR=/var/lib/app/kb_uploads

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
# Global rate limit: max requests per window (default: 600 per 60s)
# GLOBAL_MAX_REQUESTS=600
# GLOBAL_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Brevo (Email/SMS Marketing)
# -----------------------------------------------------------------------------
# Brevo REST API key (starts with xkeysib-...)
# Either set BREVO_API_KEY directly, or set BREVO_MCP_TOKEN (base64 JSON
# containing api_key field) and the backend will extract the key automatically.
BREVO_API_KEY=
# BREVO_MCP_TOKEN=
# SMS sender name (max 11 characters)
SMS_SENDER=Workstation
# Default SMS recipient in E.164 format (e.g. 14155551234)
SMS_DEFAULT_RECIPIENT=

# -----------------------------------------------------------------------------
# Local Drupal Mirror
# -----------------------------------------------------------------------------
# Host port for the local Drupal container (internal: 80)
DRUPAL_PORT=8080
# Comma-separated hostnames to bypass SSRF checks (for local Drupal mirror)
DRUPAL_ALLOWED_HOSTS=drupal.local

# -----------------------------------------------------------------------------
# Drupal VPS / Staging (SSH-based clone & push to production)
# -----------------------------------------------------------------------------
# Production VPS hostname or IP
DRUPAL_VPS_HOST=
# SSH username (default: root)
DRUPAL_VPS_USER=root
# SSH password (leave empty if using key-based auth)
DRUPAL_VPS_PASSWORD=
# Path to SSH private key (inside container; leave empty to use password)
DRUPAL_VPS_KEY_PATH=
# SSH port (default: 22)
DRUPAL_VPS_PORT=22

# Weaviate API key (development example only; use a strong key in production)
WEAVIATE_API_KEY=devkey
