{
  "id": "vue",
  "name": "Vue",
  "description": "Vue 3 progressive framework for building user interfaces",
  "category": "frontend",
  "dependencies": ["vue@^3.5.0", "vite@^7.3.0", "typescript@^5.9.0", "@vitejs/plugin-vue@^6.0.0", "vue-tsc@^2.2.0"],
  "install_commands": ["npm install"],
  "scaffold_files": {
    "package.json": "{\n  \"name\": \"vue-app\",\n  \"private\": true,\n  \"version\": \"0.1.0\",\n  \"type\": \"module\",\n  \"scripts\": {\n    \"dev\": \"vite\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview\",\n    \"typecheck\": \"vue-tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"vue\": \"^3.5.0\"\n  },\n  \"devDependencies\": {\n    \"@vitejs/plugin-vue\": \"^6.0.0\",\n    \"vite\": \"^7.3.0\",\n    \"typescript\": \"^5.9.0\",\n    \"vue-tsc\": \"^2.2.0\"\n  }\n}\n",
    "src/App.vue": "<script setup lang=\"ts\">\nimport { ref } from 'vue'\nconst message = ref('Hello from Vue 3')\n</script>\n\n<template>\n  <div style=\"padding: 2rem; font-family: sans-serif\">\n    <h1>{{ message }}</h1>\n  </div>\n</template>\n",
    "src/main.ts": "import { createApp } from 'vue'\nimport App from './App.vue'\n\ncreateApp(App).mount('#app')\n",
    "index.html": "<!DOCTYPE html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>Vue App</title>\n  </head>\n  <body>\n    <div id=\"app\"></div>\n    <script type=\"module\" src=\"/src/main.ts\"></script>\n  </body>\n</html>\n",
    "vite.config.ts": "import { defineConfig } from 'vite'\nimport vue from '@vitejs/plugin-vue'\n\nexport default defineConfig({\n  plugins: [vue()],\n})\n",
    "tsconfig.json": "{\n  \"compilerOptions\": {\n    \"target\": \"ES2020\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"strict\": true,\n    \"jsx\": \"preserve\",\n    \"resolveJsonModule\": true,\n    \"esModuleInterop\": true,\n    \"lib\": [\"ES2020\", \"DOM\", \"DOM.Iterable\"],\n    \"types\": [\"vite/client\"]\n  },\n  \"include\": [\"src/**/*.ts\", \"src/**/*.vue\", \"vite.config.ts\"]\n}\n"
  },
  "environment": {},
  "sidecar_services": [],
  "requires_technologies": ["node"],
  "conflicts_with": ["react"],
  "docker_image": null,
  "exposed_ports": [5173]
}
